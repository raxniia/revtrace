{
  "name": "RevTrace",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "postCreateCommand": "pip install -e '.[dev]' && cd frontend && npm ci && npm run build",
  "forwardPorts": [
    8000
  ],
  "portsAttributes": {
    "8000": {
      "label": "RevTrace dashboard",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff"
      ]
    }
  },
  "postStartCommand": "nohup revtrace serve --host 0.0.0.0 --port 8000 > /tmp/revtrace.log 2>&1 &"
}
